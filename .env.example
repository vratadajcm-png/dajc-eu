# Copy this file to .env.local for local development. Never commit the
# real .env.local (it is already in .gitignore).
#
# In production (GitHub Actions), these are set via repository secrets
# instead - see docs/NEWS_AUTOMATION.md. OpenAI is not used.

# Perplexity Search API - web discovery in scripts/oversize-monitor.mjs.
PERPLEXITY_API_KEY=

# Claude - classifies Search leads and writes the weekly edition
# (scripts/lib/article-writer.mjs). Not needed with --mock.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults: claude-haiku-5-5 / claude-sonnet-5-5).
CLAUDE_CLASSIFIER_MODEL=
CLAUDE_REVIEW_MODEL=

# --- DAJC Partner Portal (docs/PARTNER_PORTAL.md) ---------------------------
# This entire subsystem is a private, disabled-by-default governance layer.
# It ships fully built but MUST stay unreachable in production until the
# DAJC Platform owner explicitly turns it on. Never set the gate to "true"
# in a shared/production environment without that explicit decision.

# Central feature gate. MUST be the exact string "true" to enable the
# portal - anything else (missing, empty, "TRUE", "1"...) leaves every
# portal route, email send and admin surface returning 404. Defaults to
# disabled; do not set this in production without explicit sign-off.
DAJC_PARTNER_PORTAL_ENABLED=false

# Supabase Postgres connection string for the Partner Portal schema only
# (src/portal/db/schema.ts). Not required for astro build/dev/test - the
# DB client connects lazily, only when a portal route actually runs.
DAJC_PARTNER_DB_URL=

# Comma-separated DAJC staff emails allowed to sign into the admin surface.
# Empty/missing = nobody can sign in as admin (deny-by-default).
DAJC_PARTNER_ADMIN_ALLOWLIST=

# Resend API key for invitation/magic-link emails from team@dajc.eu.
RESEND_API_KEY=
DAJC_PARTNER_EMAIL_FROM=

# Must be the exact string "live" for real emails to be sent via Resend.
# Any other value (missing, "dev", a typo) uses a safe sender that never
# makes a network call - see src/portal/lib/email.ts. This is a SEPARATE
# safety layer from DAJC_PARTNER_PORTAL_ENABLED, not a substitute for it.
DAJC_PARTNER_EMAIL_MODE=


# --- DAJC Platform Testing 2027 registration ------------------------------
# Public registration endpoint: /api/testing-register
# Registrations are delivered to platform@dajc.cz.
# Uses RESEND_API_KEY above. Configure a verified dajc.eu sender in production.
DAJC_TESTING_EMAIL_FROM="DAJC Platform <team@dajc.eu>"

# --- DAJC Intelligence: Driving Bans module (not released) -----------------
# Module switch of the Intelligence Driving Bans query service. Exact "true"
# only, and only together with a reviewed release change
# (DRIVING_BANS_INTELLIGENCE_RELEASED). Per-feature switches:
# DAJC_INTELLIGENCE_VEHICLE_AWARE_ENABLED, ..._ROUTE_AWARE_, ..._HISTORY_, ..._ALERTS_.
DAJC_INTELLIGENCE_BANS_ENABLED=false
# Personal paid calendar feed (secret URL per subscriber); no route mounts it yet.
DAJC_INTELLIGENCE_CALENDAR_ENABLED=false

# --- Driving Bans AI research (drafts only, never publishes) ---------------
# Exact "true" enables `npm run driving-bans:research -- run`; it also needs
# both budgets and two configured vendors. See docs/DRIVING_BANS_RESEARCH.md.
DAJC_DRIVING_BANS_RESEARCH_ENABLED=false
# Separate keys for research only (never the Weekly's or Ask's keys).
DAJC_RESEARCH_ANTHROPIC_API_KEY=
DAJC_RESEARCH_OPENAI_API_KEY=
DAJC_RESEARCH_XAI_API_KEY=
DAJC_RESEARCH_GEMINI_API_KEY=
DAJC_RESEARCH_MISTRAL_API_KEY=
DAJC_RESEARCH_PERPLEXITY_API_KEY=
# Model names only here; no defaults in code.
DAJC_RESEARCH_ANTHROPIC_MODEL=
DAJC_RESEARCH_OPENAI_MODEL=
DAJC_RESEARCH_XAI_MODEL=
DAJC_RESEARCH_GEMINI_MODEL=
DAJC_RESEARCH_MISTRAL_MODEL=
# USD per 1M tokens per provider, USD per search request; missing = provider off.
# e.g. {"anthropic":{"input":0,"output":0},"perplexity":{"request":0}}
DAJC_RESEARCH_PRICING_USD=
# Spend caps in USD (per run and per calendar month); 0 or empty = research off.
DAJC_RESEARCH_RUN_BUDGET_USD=
DAJC_RESEARCH_MONTHLY_BUDGET_USD=
DAJC_RESEARCH_MAX_REQUESTS_PER_RUN=200
# Optional: task routing by provider id (comma-separated) and cost preference.
DAJC_RESEARCH_ROUTE_DISCOVER=
DAJC_RESEARCH_ROUTE_EXTRACT=
DAJC_RESEARCH_ROUTE_EXTRACT_COMPLEX=
DAJC_RESEARCH_ROUTE_VERIFY=
DAJC_RESEARCH_PREFER_LOWER_COST=false
# Optional: measured model choices from the DAJC AI bake-off (config/ai-research-models.json)
# for providers that have a key but no explicit model; explicit settings always win.
DAJC_RESEARCH_MODEL_PROFILE=
# Optional per-task models (each needs its price under "models" in DAJC_RESEARCH_PRICING_USD),
# e.g. DAJC_RESEARCH_OPENAI_MODEL_EXTRACT_COMPLEX for PDFs and large documents.
# Optional reasoning settings: DAJC_RESEARCH_ANTHROPIC_EFFORT, DAJC_RESEARCH_OPENAI_REASONING_EFFORT,
# DAJC_RESEARCH_XAI_REASONING_EFFORT. Pacing: DAJC_RESEARCH_<PROVIDER>_MIN_INTERVAL_MS.
DAJC_RESEARCH_COMPLEX_INPUT_TOKENS=30000
DAJC_RESEARCH_MAX_RETRY_WAIT_MS=120000

# --- Google Search identity ------------------------------------------------
# Optional Search Console verification token for the public DAJC.eu site.
# Paste only the token value supplied by Google; leave empty until verification.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Private investor downloads: server-only secrets; never commit real values.
DAJC_INVESTOR_ACCESS_CODE=
DAJC_INVESTOR_DOCUMENT_KEY=

# --- Ask DAJC AI (DAJC Intelligence, master plan §47 Phase 1) ---------------
# Free questions with a daily limit; nothing is sold. See docs/ASK_DAJC_AI.md.
# Server-only: never prefix any of these with PUBLIC_, never commit values.
# Central gate: the exact string "true" enables it, and only together with a
# complete configuration below - anything missing keeps every /api/ask route
# and /intelligence/ask at 404. Keep "false" until the launch checklist in
# docs/ASK_DAJC_AI.md is signed off.
DAJC_ASK_ENABLED=false

# Postgres connection as the least-privileged role dajc_ask_app (schema
# dajc_ask, migrations in drizzle-ask/). Without it the feature stays off.
DAJC_ASK_DB_URL=

# Separate provider keys and projects with their own monthly spend limits -
# never the article pipeline's OPENAI_API_KEY / ANTHROPIC_API_KEY /
# PERPLEXITY_API_KEY nor the Driving Bans research DAJC_RESEARCH_*_API_KEY.
# A copied key keeps the feature off.
DAJC_ASK_OPENAI_API_KEY=
DAJC_ASK_ANTHROPIC_API_KEY=
DAJC_ASK_PERPLEXITY_API_KEY=

# Model names only here (provider-neutral code, no defaults).
DAJC_ASK_OPENAI_CLASSIFIER_MODEL=
DAJC_ASK_OPENAI_ANSWER_MODEL=
DAJC_ASK_ANTHROPIC_VERIFIER_MODEL=

# Provider prices for cost accounting: USD per 1M tokens per role, USD per
# search request; and EUR per 1 USD. Missing or invalid = feature off.
DAJC_ASK_PRICING_USD=
DAJC_ASK_USD_EUR_RATE=

# Cost caps in EUR (the feature pauses itself when a cap is reached) and
# questions per verified e-mail per Prague day.
DAJC_ASK_MONTHLY_BUDGET_EUR=20
DAJC_ASK_DAILY_BUDGET_EUR=2
DAJC_ASK_DAILY_QUERY_LIMIT=3

# HMAC key for e-mail and IP fingerprints (at least 32 random characters).
# Rotating it resets everyone's sign-in and daily counters.
DAJC_ASK_EMAIL_PEPPER=

# Sign-in e-mails use RESEND_API_KEY above; real e-mails only with "live".
DAJC_ASK_EMAIL_FROM="DAJC <team@dajc.eu>"
DAJC_ASK_EMAIL_MODE=

# Origin used in sign-in links (default https://www.dajc.eu).
DAJC_ASK_PUBLIC_ORIGIN=

# Shared cache of checked generic answers (needs drizzle-ask 0002). Optional.
DAJC_ASK_ANSWER_CACHE_ENABLED=false

# ---------------------------------------------------------------------------
# DAJC AI account and paid DAJC AI (EUR 15 / month) - docs/DAJC_AI_PAID_OPERATIONS.md
# Everything is OFF unless Ask DAJC AI is on AND these are set. Live payments
# and live accounting are additionally blocked by reviewed code constants
# (DAJC_AI_PAID_RELEASED, DAJC_AI_LIVE_PAYMENTS_RELEASED,
# DAJC_ACCOUNTING_LIVE_RELEASED), which are false.
# ---------------------------------------------------------------------------
# Account panel: consents, export, deletion, error reports (needs migrations 0002/0003).
DAJC_AI_ACCOUNT_ENABLED=false
# AES-256-GCM keys for personal content: "k2026a:<base64 32 bytes>[,older:<...>]".
DAJC_AI_DATA_KEYS=
DAJC_AI_PAID_ENABLED=false
DAJC_AI_DRIVING_BANS_ENABLED=false
# stripe | revolut | gpwebpay | sandbox ; mode sandbox | live
DAJC_AI_PAYMENT_PROVIDER=
DAJC_AI_PAYMENT_MODE=sandbox
# Staging dry run on a Vercel preview deployment only (never production).
DAJC_AI_STAGING_SANDBOX=false
DAJC_AI_SANDBOX_WEBHOOK_SECRET=
DAJC_AI_STRIPE_SECRET_KEY=
DAJC_AI_STRIPE_WEBHOOK_SECRET=
DAJC_AI_STRIPE_PRICE_ID=
DAJC_AI_REVOLUT_SECRET_KEY=
DAJC_AI_REVOLUT_WEBHOOK_SECRET=
DAJC_AI_GPWEBPAY_MERCHANT_NUMBER=
DAJC_AI_GPWEBPAY_PRIVATE_KEY_PEM=
DAJC_AI_GPWEBPAY_PRIVATE_KEY_PASSPHRASE=
DAJC_AI_GPWEBPAY_PUBLIC_KEY_PEM=
# Fair use (defaults shown) and refund policy.
DAJC_AI_PAID_DAILY_QUERY_LIMIT=30
DAJC_AI_PAID_MONTHLY_QUERY_LIMIT=400
DAJC_AI_PAID_USER_MONTHLY_COST_EUR=5
DAJC_AI_REFUND_WINDOW_DAYS=14
DAJC_AI_REFUND_MAX_SELF_SERVICE=1
DAJC_AI_REFUND_MAX_PAID_QUESTIONS=20
DAJC_AI_HISTORY_RETENTION_DAYS=90
DAJC_AI_MEMORY_RETENTION_DAYS=365
# Bearer secret of the scheduled maintenance call (outbox, retention, report); >= 32 chars.
DAJC_AI_MAINTENANCE_SECRET=

# ABRA Flexi (accounting authority). sandbox = an ABRA test company only.
DAJC_ABRA_MODE=
DAJC_ABRA_URL=
DAJC_ABRA_COMPANY=
DAJC_ABRA_USERNAME=
DAJC_ABRA_PASSWORD=
# VAT rates in percent per country, confirmed by the accountant, e.g. {"CZ":21,...}.
DAJC_VAT_RATES_JSON=
DAJC_VAT_RATES_CONFIRMED_BY=
DAJC_SUPPLIER_COUNTRY=CZ
