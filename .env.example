# Copy this file to .env.local for local development. Never commit the
# real .env.local (it is already in .gitignore).
#
# In production (GitHub Actions), this is set via the OPENAI_API_KEY
# repository secret instead - see docs/NEWS_AUTOMATION.md.

# Required to run scripts/generate-weekly-article.mjs in live mode.
# Not needed for scripts/oversize-monitor.mjs (it never calls OpenAI).
# Not needed at all if you only pass --mock to the weekly generator.
OPENAI_API_KEY=

# Optional. Overrides the default model used for weekly article synthesis
# (see scripts/lib/openai-client.mjs). Review what's current before setting.
OPENAI_MODEL=
