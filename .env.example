# Copy this file to .env.local for local development. Never commit the
# real .env.local (it is already in .gitignore).
#
# In production (GitHub Actions), these are set via repository secrets
# instead - see docs/NEWS_AUTOMATION.md. OpenAI is not used.

# Perplexity Search API - web discovery in scripts/oversize-monitor.mjs.
PERPLEXITY_API_KEY=

# Claude - classifies Search leads and writes the weekly edition
# (scripts/lib/article-writer.mjs). Not needed with --mock.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults: claude-haiku-5-5 / claude-sonnet-5-5).
CLAUDE_CLASSIFIER_MODEL=
CLAUDE_REVIEW_MODEL=

# --- DAJC Partner Portal (docs/PARTNER_PORTAL.md) ---------------------------
# This entire subsystem is a private, disabled-by-default governance layer.
# It ships fully built but MUST stay unreachable in production until the
# DAJC Platform owner explicitly turns it on. Never set the gate to "true"
# in a shared/production environment without that explicit decision.

# Central feature gate. MUST be the exact string "true" to enable the
# portal - anything else (missing, empty, "TRUE", "1"...) leaves every
# portal route, email send and admin surface returning 404. Defaults to
# disabled; do not set this in production without explicit sign-off.
DAJC_PARTNER_PORTAL_ENABLED=false

# Supabase Postgres connection string for the Partner Portal schema only
# (src/portal/db/schema.ts). Not required for astro build/dev/test - the
# DB client connects lazily, only when a portal route actually runs.
DAJC_PARTNER_DB_URL=

# Comma-separated DAJC staff emails allowed to sign into the admin surface.
# Empty/missing = nobody can sign in as admin (deny-by-default).
DAJC_PARTNER_ADMIN_ALLOWLIST=

# Resend API key for invitation/magic-link emails from team@dajc.eu.
RESEND_API_KEY=
DAJC_PARTNER_EMAIL_FROM=

# Must be the exact string "live" for real emails to be sent via Resend.
# Any other value (missing, "dev", a typo) uses a safe sender that never
# makes a network call - see src/portal/lib/email.ts. This is a SEPARATE
# safety layer from DAJC_PARTNER_PORTAL_ENABLED, not a substitute for it.
DAJC_PARTNER_EMAIL_MODE=


# --- DAJC Platform Testing 2027 registration ------------------------------
# Public registration endpoint: /api/testing-register
# Registrations are delivered to platform@dajc.cz.
# Uses RESEND_API_KEY above. Configure a verified dajc.eu sender in production.
DAJC_TESTING_EMAIL_FROM="DAJC Platform <team@dajc.eu>"

# --- Google Search identity ------------------------------------------------
# Optional Search Console verification token for the public DAJC.eu site.
# Paste only the token value supplied by Google; leave empty until verification.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Private investor downloads: server-only secrets; never commit real values.
DAJC_INVESTOR_ACCESS_CODE=
DAJC_INVESTOR_DOCUMENT_KEY=

# --- Ask DAJC AI (DAJC Intelligence, master plan §47 Phase 1) ---------------
# Free questions with a daily limit; nothing is sold. See docs/ASK_DAJC_AI.md.
# Server-only: never prefix any of these with PUBLIC_, never commit values.
# Central gate: the exact string "true" enables it, and only together with a
# complete configuration below - anything missing keeps every /api/ask route
# and /intelligence/ask at 404. Keep "false" until the launch checklist in
# docs/ASK_DAJC_AI.md is signed off.
DAJC_ASK_ENABLED=false

# Postgres connection as the least-privileged role dajc_ask_app (schema
# dajc_ask, migrations in drizzle-ask/). Without it the feature stays off.
DAJC_ASK_DB_URL=

# Separate provider keys and projects with their own monthly spend limits -
# never the article pipeline's ANTHROPIC_API_KEY / PERPLEXITY_API_KEY.
DAJC_ASK_OPENAI_API_KEY=
DAJC_ASK_ANTHROPIC_API_KEY=
DAJC_ASK_PERPLEXITY_API_KEY=

# Model names only here (provider-neutral code, no defaults).
DAJC_ASK_OPENAI_CLASSIFIER_MODEL=
DAJC_ASK_OPENAI_ANSWER_MODEL=
DAJC_ASK_ANTHROPIC_VERIFIER_MODEL=

# Provider prices for cost accounting: USD per 1M tokens per role, USD per
# search request; and EUR per 1 USD. Missing or invalid = feature off.
DAJC_ASK_PRICING_USD=
DAJC_ASK_USD_EUR_RATE=

# Cost caps in EUR (the feature pauses itself when a cap is reached) and
# questions per verified e-mail per Prague day.
DAJC_ASK_MONTHLY_BUDGET_EUR=20
DAJC_ASK_DAILY_BUDGET_EUR=2
DAJC_ASK_DAILY_QUERY_LIMIT=3

# HMAC key for e-mail and IP fingerprints (at least 32 random characters).
# Rotating it resets everyone's sign-in and daily counters.
DAJC_ASK_EMAIL_PEPPER=

# Sign-in e-mails use RESEND_API_KEY above; real e-mails only with "live".
DAJC_ASK_EMAIL_FROM="DAJC <team@dajc.eu>"
DAJC_ASK_EMAIL_MODE=

# Origin used in sign-in links (default https://www.dajc.eu).
DAJC_ASK_PUBLIC_ORIGIN=
