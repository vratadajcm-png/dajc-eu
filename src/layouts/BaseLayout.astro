---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DAJCGuide from '../components/DAJCGuide.astro';
import TrafficAnalytics from '../components/TrafficAnalytics.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const siteName = 'DAJC';
const siteURL = 'https://www.dajc.eu/';
const brandLogoURL = 'https://www.dajc.eu/assets/dajc-google-brand.svg';
const isHomePage = Astro.url.pathname === '/';

const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: siteName,
      alternateName: 'DAJC.eu',
      publisher: {
        '@id': `${siteURL}#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteURL}#organization`,
      name: siteName,
      alternateName: 'DAJC.eu',
      url: siteURL,
      description: 'European heavy and oversized transport platform and execution layer.',
      email: 'team@dajc.eu',
      logo: {
        '@type': 'ImageObject',
        url: brandLogoURL,
        contentUrl: brandLogoURL,
        width: 512,
        height: 512,
      },
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="application-name" content={siteName} />
  <meta name="theme-color" content="#061A33" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/assets/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={brandLogoURL} />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:image:alt" content="DAJC" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={brandLogoURL} />
  {isHomePage && <script type="application/ld+json" set:html={JSON.stringify(homeStructuredData)}></script>}
</head>
<body>
  <div class="grid-bg"></div>
  <Header />
  <slot />
  <Footer />
  <DAJCGuide />
  <TrafficAnalytics />
</body>
</html>
