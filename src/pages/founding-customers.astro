---
import BaseLayout from '../layouts/BaseLayout.astro';
const options = [
  { id: 'platform', label: 'DAJC Platform', amount: '199 €', timeline: 'Q3 2027', desc: 'European heavy & oversized transport operating platform.', note: 'Planned pre-production testing.' },
  { id: 'tar', label: 'DAJC TAR', amount: '299 €', timeline: 'Q1 2028 (tentative)', desc: 'Tow, Assistance & Recovery for mixed service fleets.', note: 'Tentative pre-production testing.' },
  { id: 'both', label: 'Platform + TAR', amount: '399 €', timeline: 'Separate product schedules', desc: 'A potential founding-customer package for both independent B2B products.', note: 'Each product retains its own testing programme.' },
];
---
<BaseLayout
  title="DAJC Founding Customers | Platform & TAR"
  description="Explore the proposed founding-customer reservation programme for DAJC Platform and DAJC TAR. Request an individual B2B offer; no reservation or payment is taken on this page."
>
  <main class="founding">
    <section class="hero">
      <p class="kicker">DAJC FOUNDING CUSTOMERS · B2B</p>
      <h1>Reserve the conversation today. Shape tomorrow's operations.</h1>
      <p class="lead">DAJC is preparing a founding-customer programme for companies interested in the future <strong>DAJC Platform</strong> and <strong>DAJC TAR</strong>. Register your interest now to discuss a future paid reservation and planned pre-production testing.</p>
      <div class="principles">
        <span>Business customers</span><span>Early testing opportunity</span><span>No subscription before launch</span>
      </div>
      <a href="#interest" class="cta">Request founding-customer terms</a>
    </section>

    <section class="offer" aria-labelledby="offer-title">
      <p class="kicker">PROPOSED RESERVATION OPTIONS</p>
      <h2 id="offer-title">Choose your area of interest</h2>
      <p class="hint">These prices are indicative proposals for a possible one-time reservation payment. <strong>No paid reservations are open.</strong> A confirmed offer, contract, payment link and invoicing details will be provided separately after commercial and legal verification.</p>
      <div class="cards">
        {options.map((o) => (
          <article>
            <p class="card-kicker">BUSINESS · FUTURE SOFTWARE</p>
            <h3>{o.label}</h3>
            <p class="description">{o.desc}</p>
            <p class="amount">{o.amount}</p>
            <p class="tiny">Indicative one-time reservation, per organisation</p>
            <div class="timeline"><strong>Testing:</strong> {o.timeline}</div>
            <p class="tiny">{o.note}</p>
            <a href="#interest" data-choose={o.id}>Discuss this option</a>
          </article>
        ))}
      </div>
    </section>

    <section class="process">
      <p class="kicker">HOW IT WOULD WORK</p>
      <h2>Clear terms before any money changes hands.</h2>
      <ol>
        <li><strong>Enquire.</strong> Tell DAJC which product your organisation is considering. This does not reserve a place.</li>
        <li><strong>Review.</strong> Receive an individual offer with the legal seller, agreed benefits, a latest date for testing access, cancellation/refund terms, taxes and payment details.</li>
        <li><strong>Reserve later.</strong> A place is confirmed only after both parties accept the final terms and payment is verified. No reservation exists before that.</li>
        <li><strong>Test &amp; activate.</strong> Planned testing concerns the same evolving production product, not a separate Pilot or Early Access edition. Any eventual subscription starts only on commercial activation.</li>
      </ol>
      <p class="note">Platform testing is planned for Q3 2027. TAR testing is tentatively planned for Q1 2028. These are development targets, not guaranteed dates. Exact rights and remedies will be set by an individual agreement before payment.</p>
    </section>

    <section id="interest" class="interest" aria-labelledby="interest-heading">
      <div>
        <p class="kicker">FIRST STEP · NO PAYMENT</p>
        <h2 id="interest-heading">Request a founding-customer offer</h2>
        <p>Complete the information below. Your own email app will prepare a message addressed to <a href="mailto:team@dajc.eu">team@dajc.eu</a>; review and send it yourself. <strong>Nothing is submitted or stored by DAJC.eu when you click the button.</strong></p>
        <p>You will not be charged and this expression of interest is not a binding booking or a guaranteed invitation to testing.</p>
      </div>
      <form id="founding-interest" class="interest-form">
        <label>Product of interest *
          <select name="product" required>
            <option value="platform">DAJC Platform</option>
            <option value="tar">DAJC TAR</option>
            <option value="both">Platform + TAR</option>
          </select>
        </label>
        <label>Company name *
          <input name="company" required autocomplete="organization" maxlength="160"/>
        </label>
        <div class="field-row">
          <label>Contact name *
            <input name="contact" required autocomplete="name" maxlength="120"/>
          </label>
          <label>Business email *
            <input name="email" required type="email" autocomplete="email" maxlength="254"/>
          </label>
        </div>
        <div class="field-row">
          <label>Country *
            <input name="country" required autocomplete="country-name" maxlength="100"/>
          </label>
          <label>Company ID / VAT ID (optional)
            <input name="companyId" maxlength="70"/>
          </label>
        </div>
        <label>Your organisation's main activity
          <select name="activity">
            <option value="Carrier / oversized transport">Carrier / oversized transport</option>
            <option value="Towing, assistance and recovery">Towing, assistance and recovery</option>
            <option value="Logistics / dispatcher">Logistics / dispatcher</option>
            <option value="Other">Other</option>
          </select>
        </label>
        <label class="consent"><input type="checkbox" required name="consent"/> <span>I have read the <a href="/privacy" target="_blank" rel="noopener noreferrer">privacy notice</a> and understand that sending the prepared email will share my details for a B2B enquiry only, not create a paid reservation.</span></label>
        <button type="submit">Prepare enquiry email</button>
        <p id="interest-status" class="status" role="status" aria-live="polite"></p>
        <p class="tiny">If your email application does not open, write directly to <a href="mailto:team@dajc.eu?subject=DAJC%20Founding%20Customers%20enquiry">team@dajc.eu</a>.</p>
      </form>
    </section>
    <section class="disclaimer">
      <h2>About the founding-customer programme</h2>
      <p>This page describes a proposal under preparation. It is not a contractual offer, order form, paid pre-sale or financial investment. DAJC does not take advance payments here. Future testing and commercial services may change as development proceeds.</p>
      <p>Existing free <a href="/testing">DAJC Platform testing registration</a> remains available independently of this proposed programme. Voluntary contributions on the separate <a href="/support">Support</a> page do not provide reservation rights.</p>
    </section>
  </main>
  <script>
    const form = document.querySelector<HTMLFormElement>('#founding-interest');
    const status = document.querySelector<HTMLElement>('#interest-status');
    document.querySelectorAll<HTMLAnchorElement>('[data-choose]').forEach((link) => {
      link.addEventListener('click', () => {
        if (!form) return;
        const select = form.querySelector<HTMLSelectElement>('select[name="product"]');
        if (select && link.dataset.choose) select.value = link.dataset.choose;
      });
    });
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form || !form.reportValidity()) return;
      const data = new FormData(form);
      const product = String(data.get('product') || 'platform');
      const products: Record<string, string> = {platform:'DAJC Platform',tar:'DAJC TAR',both:'DAJC Platform + TAR'};
      const safe = (key: string) => String(data.get(key) || '').replace(/[\r\n]+/g, ' ').slice(0,254);
      const body = [
        'Hello DAJC,',
        '',
        'We would like to discuss the DAJC Founding Customers programme.',
        'This is a non-binding B2B enquiry, not a reservation or a payment.',
        '',
        'Product: '+(products[product] || 'DAJC Platform'),
        'Company: '+safe('company'),
        'Contact: '+safe('contact'),
        'Business email: '+safe('email'),
        'Country: '+safe('country'),
        'Company / VAT ID: '+(safe('companyId') || 'Not provided'),
        'Main activity: '+safe('activity'),
        '',
        'Please send us proposed commercial terms and information on pre-production testing.',
        'Privacy notice acknowledged: yes.',
      ].join('\n');
      const subject='DAJC Founding Customers — '+(products[product]||'B2B enquiry');
      const url='mailto:team@dajc.eu?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);
      if (status) status.textContent='Your email app should open with a completed draft. Review and send it yourself; nothing has been sent yet.';
      window.location.href=url;
    });
  </script>
</BaseLayout>

<style>
  .founding{width:min(1120px,calc(100% - 3rem));margin:0 auto;padding:4rem 0 6rem;position:relative;z-index:2}
  h1,h2,h3{font-family:'Space Grotesk',sans-serif;color:var(--dajc-white);line-height:1.12}
  h1{font-size:clamp(2.5rem,6vw,4.8rem);max-width:18ch;margin:0 auto 1.25rem}
  h2{font-size:clamp(1.7rem,4vw,2.8rem);margin:.4rem 0 1rem}
  h3{font-size:1.5rem;margin:0 0 .8rem}
  p,li{color:var(--dajc-muted);line-height:1.7}
  strong{color:var(--dajc-white)}
  .kicker,.card-kicker{color:var(--dajc-orange);font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.15em;text-transform:uppercase}
  .hero{text-align:center;padding:2rem 0 4rem}
  .lead{max-width:70ch;margin:0 auto 2rem;font-size:1.08rem}
  .principles{display:flex;justify-content:center;flex-wrap:wrap;gap:.55rem;margin:0 auto 2rem}
  .principles span{border:1px solid var(--dajc-line);border-radius:60px;padding:.55rem .8rem;color:var(--dajc-white);font-size:.78rem}
  .cta,.cards a,.interest-form button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:.7rem 1.1rem;border-radius:8px;background:var(--dajc-orange);color:var(--dajc-dark);border:0;font:700 .78rem 'IBM Plex Mono',monospace;text-decoration:none;cursor:pointer}
  .offer,.process,.interest,.disclaimer{padding:3rem 0;border-top:1px solid var(--dajc-line)}
  .hint{max-width:80ch;margin-bottom:1.5rem}
  .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .cards article{display:flex;flex-direction:column;gap:.45rem;border:1px solid var(--dajc-line);border-radius:15px;padding:1.6rem;background:rgba(0,38,92,.18)}
  .cards article:last-child{border-color:var(--dajc-orange)}
  .cards .description{min-height:4.5em;margin:0}
  .cards .amount{color:var(--dajc-white);font:700 2.3rem 'Space Grotesk',sans-serif;margin:0}
  .tiny{font-size:.8rem;line-height:1.5;color:var(--dajc-muted)}
  .timeline{border-top:1px solid var(--dajc-line);padding-top:1rem;font-size:.85rem;color:var(--dajc-muted)}
  .cards a{margin-top:auto;text-align:center}
  .process ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem 3rem;padding-left:1.5rem}
  .note{border-left:3px solid var(--dajc-orange);padding:1rem;background:rgba(239,125,0,.07)}
  .interest{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:2.5rem;align-items:start}
  .interest a,.disclaimer a{color:var(--dajc-orange)}
  .interest-form{display:grid;gap:1rem;border:1px solid var(--dajc-line);border-radius:12px;padding:1.6rem;background:rgba(0,20,52,.45)}
  .interest-form label{display:grid;gap:.4rem;color:var(--dajc-white);font:.85rem 'IBM Plex Sans',sans-serif}
  input,select{width:100%;box-sizing:border-box;min-height:45px;padding:.65rem .75rem;color:var(--dajc-white);background:#091c36;border:1px solid var(--dajc-line);border-radius:7px;font:inherit}
  .field-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .interest-form .consent{display:flex;align-items:flex-start;gap:.7rem;line-height:1.5;color:var(--dajc-muted);font-size:.8rem}
  .consent input{width:auto;min-height:0;margin-top:.25rem}
  .status{font-size:.81rem;margin:0;color:#86d1a0}
  .disclaimer{max-width:80ch}
  :is(input,select,button,a):focus-visible{outline:2px solid var(--dajc-orange);outline-offset:3px}
  @media(max-width:860px){.cards{grid-template-columns:1fr}.cards .description{min-height:0}.process ol,.interest{grid-template-columns:1fr}}
  @media(max-width:550px){.founding{width:calc(100% - 2rem);padding-top:2rem}.field-row{grid-template-columns:1fr}.interest-form{padding:1.1rem}}
</style>
