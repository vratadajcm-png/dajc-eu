---
import BaseLayout from '../layouts/BaseLayout.astro';

const demoUrl = import.meta.env.PUBLIC_DAJC_DEMO_URL?.trim();
const supportUrl = import.meta.env.PUBLIC_DAJC_SUPPORT_URL?.trim();
---
<BaseLayout
  title="DAJC Access - DAJC"
  description="Public DAJC resources and demo remain open while development continues. Optional development support helps fund DAJC Tacho first and the full DAJC Platform next."
>
  <main class="pricing-page">
    <p class="eyebrow">DAJC access</p>
    <h1>Open demo now. Build the production tools step by step.</h1>
    <p class="lead">
      DAJC is under active development. Public resources and the Platform Demo remain open while production capabilities are built and validated.
      Optional development support helps fund the next engineering stages without presenting the demo as a finished commercial product.
    </p>

    <section class="cards" aria-label="DAJC access options">
      <article>
        <p class="tier">Public DAJC.eu</p>
        <h2>Free</h2>
        <p>Public operational information, DAJC news, the Driving Bans Calendar and Integration Ecosystem remain openly accessible.</p>
        <a href="/driving-bans">Open public tools</a>
      </article>

      <article class="featured">
        <p class="tier">DAJC Platform Demo</p>
        <h2>Public sandbox</h2>
        <p>
          Explore the product direction in a non-production environment. The demo is not a customer account, purchase, pilot admission or production service.
        </p>
        {demoUrl ? (
          <a href={demoUrl} target="_blank" rel="noopener noreferrer">Open public demo</a>
        ) : (
          <span class="pending">Public demo link will appear here</span>
        )}
      </article>

      <article>
        <p class="tier">Support DAJC development</p>
        <h2>Optional development funding</h2>
        <p>
          Support contributes to DAJC development and related operating/API costs. The current engineering priority is DAJC Tacho; after Tacho reaches release-ready,
          the funding priority moves to the full DAJC Platform.
        </p>
        {supportUrl ? (
          <a href={supportUrl} target="_blank" rel="noopener noreferrer">Support development</a>
        ) : (
          <span class="pending">Support checkout opening soon</span>
        )}
      </article>

      <article>
        <p class="tier">DAJC Platform</p>
        <h2>In development</h2>
        <p>
          The production workflow for European heavy and oversized transport is being developed separately from the public demo. Commercial launch terms will be published only when confirmed.
        </p>
        <a href="mailto:team@dajc.eu?subject=DAJC%20Platform%20Interest">Contact DAJC</a>
      </article>

      <article>
        <p class="tier">DAJC Intelligence</p>
        <h2>In development</h2>
        <p>An operational intelligence layer is being developed alongside DAJC's public information resources.</p>
        <a href="/intelligence">Explore Intelligence</a>
      </article>

      <article>
        <p class="tier">Data &amp; integrations</p>
        <h2>Evaluated individually</h2>
        <p>Integration and data access depend on technical fit, permissions, licensing and source rights. External provider costs are not silently bundled into the public demo.</p>
        <a href="/partners">Integration Ecosystem</a>
      </article>
    </section>

    <section class="guardrail">
      <h2>What development support does — and does not — mean</h2>
      <p>
        Development support is separate from DAJC Platform subscriptions and third-party data/API usage. It does not create a customer account, guarantee pilot access,
        reserve future functionality, buy equity or convert the public demo into a production service. Confirmed commercial terms will be published separately before paid product access begins.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .pricing-page{position:relative;z-index:2;max-width:1080px;margin:0 auto;padding:8vh 1.5rem 9vh;text-align:center}.eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--dajc-orange);margin:0 0 1rem}h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,3.3rem);line-height:1.05;margin:0 auto 1rem;max-width:20ch}.lead{max-width:72ch;margin:0 auto 3rem;color:var(--dajc-muted);font-size:17px;line-height:1.7}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;text-align:left}.cards article{padding:1.5rem;border:1px solid var(--dajc-line);border-radius:14px;background:rgba(0,38,92,.16)}.cards article.featured{border-color:var(--dajc-orange)}.tier{margin:0 0 .5rem;color:var(--dajc-orange);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.07em;text-transform:uppercase}.cards h2{margin:0 0 .8rem;font-family:'Space Grotesk',sans-serif}.cards p{color:var(--dajc-muted);line-height:1.65}.cards a{display:inline-flex;min-height:42px;align-items:center;margin-top:.5rem;padding:0 .85rem;border:1px solid var(--dajc-orange);border-radius:8px;color:var(--dajc-orange);text-decoration:none;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.06em;text-transform:uppercase}.featured a{background:var(--dajc-orange);color:var(--dajc-dark)}.pending{display:inline-flex;min-height:42px;align-items:center;margin-top:.5rem;padding:0 .85rem;border:1px solid var(--dajc-line);border-radius:8px;color:var(--dajc-muted);font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.04em;text-transform:uppercase}.guardrail{margin-top:3rem;padding:1.5rem;border-top:1px solid var(--dajc-line)}.guardrail h2{font-family:'Space Grotesk',sans-serif}.guardrail p{max-width:72ch;margin:0 auto;color:var(--dajc-muted);line-height:1.7}@media(max-width:680px){.cards{grid-template-columns:1fr}.pricing-page{padding-left:1rem;padding-right:1rem}}
</style>
