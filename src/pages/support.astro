---
import BaseLayout from '../layouts/BaseLayout.astro';

const revolutPaymentLink = 'https://checkout.revolut.com/pay/f4dadeed-6fd2-45fc-822d-51bc1c74da05';
const lnurl = 'lnurl1dp68gurn8ghj7amhwuhxzmnevdhkjm3wvdaz7ctsdyhkc6t8dp6xu6twvuhkcmn4wfkz7c3svsexgcnrvykk2cfsxvkngdfjvvknjcmzx5knzde3x5ergepsvejkgdg2espjg';
const btcAddress = 'bc1qc0xd7rtvzefgkeettvrrkvgzgee405nkqdcm6s';
---
<BaseLayout
  title="Support DAJC.eu — Card, Lightning & Bitcoin"
  description="Support the independent operation and development of DAJC.eu with a voluntary contribution by card, Lightning or Bitcoin."
>
  <main class="support">
    <p class="eyebrow">SUPPORT DAJC.EU</p>
    <h1>Support independent heavy &amp; oversized transport information</h1>
    <p class="lead">DAJC.eu is an independent project. Voluntary contributions help cover hosting, infrastructure, research and continued development of the public website.</p>

    <section class="method-grid" aria-label="Contribution methods">
      <article class="method-card revolut-method">
        <div>
          <span class="method">€ EUR · REVOLUT</span>
          <h2>Card</h2>
          <p>Choose your own amount in EUR and continue to Revolut secure checkout.</p>
        </div>
        <a class="method-action" href={revolutPaymentLink} target="_blank" rel="noopener noreferrer">Open</a>
      </article>

      <details class="method-card payment-details">
        <summary>
          <span>
            <span class="method">BITCOIN · LIGHTNING</span>
            <strong>Lightning</strong>
            <small>Fast Bitcoin payment via Lightning Network</small>
          </span>
          <span class="method-action summary-action">Open</span>
        </summary>
        <div class="detail-content lightning-layout">
          <div>
            <p>Choose the amount in your Lightning wallet. Contributions are voluntary and do not create a subscription, service entitlement or investment relationship.</p>
            <div class="actions">
              <button class="button primary" id="share-lnurl" type="button" data-lnurl={lnurl}>Share to wallet</button>
              <button class="button secondary" id="copy-lnurl" type="button" data-lnurl={lnurl}>Copy for Lightning wallet</button>
              <a class="button tertiary" href={`lightning:${lnurl}`}>Open Lightning wallet</a>
            </div>
            <p class="status" id="copy-status" aria-live="polite"></p>
            <div class="warning" role="note">
              <strong>Important:</strong> the copied LNURL is not a web address. Paste it only into the Send/Pay field of a Lightning wallet.
            </div>
            <details class="manual">
              <summary>Show LNURL for manual copy</summary>
              <code>{lnurl}</code>
            </details>
          </div>
          <div class="qr-wrap">
            <img src="/assets/dajc-lightning-lnurl.svg" alt="QR code for the DAJC.eu Lightning LNURL" width="320" height="320" />
            <p>Scan with a Lightning wallet</p>
          </div>
        </div>
      </details>

      <details class="method-card payment-details">
        <summary>
          <span>
            <span class="method">BITCOIN · ON-CHAIN</span>
            <strong>Bitcoin on-chain</strong>
            <small>Standard Bitcoin transfer to the DAJC.eu address</small>
          </span>
          <span class="method-action summary-action">Open</span>
        </summary>
        <div class="detail-content">
          <p>Use this permanent Bitcoin address for a standard on-chain BTC transfer from a compatible wallet or exchange.</p>
          <div class="address-box" aria-label="DAJC.eu Bitcoin address">
            <code>{btcAddress}</code>
          </div>
          <div class="actions">
            <a class="button primary" href={`bitcoin:${btcAddress}`}>Open Bitcoin wallet</a>
            <button class="button secondary" id="copy-btc" type="button" data-address={btcAddress}>Copy BTC address</button>
          </div>
          <p class="status" id="btc-status" aria-live="polite"></p>
          <div class="warning warning--strong" role="note">
            <strong>Minimum deposit: 0.0001 BTC.</strong> Anycoin states that a smaller amount will not be credited and may be lost. Always verify the full address before sending.
          </div>
          <div class="payment-meta">
            <span>Network: Bitcoin</span>
            <span>Address validity: Permanent</span>
            <span>Anycoin deposit fee: Free</span>
            <span>Estimated crediting: about 4 confirmations</span>
          </div>
        </div>
      </details>
    </section>

    <section class="details">
      <h2>About voluntary contributions</h2>
      <p>Contributions support DAJC.eu only. They are not payments for goods or services and do not provide ownership, financial return, priority access or other contractual benefits.</p>
      <p>Card contributions are processed by Revolut. Bitcoin and Lightning contributions are processed through the Anycoin.cz infrastructure configured for DAJC.eu. Provider-specific limits, security controls, privacy notices and terms may apply.</p>
      <p>See the <a href="/terms">Terms of Use &amp; Voluntary Contributions</a> and <a href="/privacy">Privacy Notice</a>.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-lnurl');
  const shareButton = document.querySelector<HTMLButtonElement>('#share-lnurl');
  const copyBtcButton = document.querySelector<HTMLButtonElement>('#copy-btc');
  const status = document.querySelector<HTMLElement>('#copy-status');
  const btcStatus = document.querySelector<HTMLElement>('#btc-status');

  const setStatus = (message: string) => {
    if (status) status.textContent = message;
  };

  copyButton?.addEventListener('click', async () => {
    const value = copyButton.dataset.lnurl ?? '';
    try {
      await navigator.clipboard.writeText(value);
      setStatus('Copied for a Lightning wallet. Paste it into Send/Pay inside your wallet.');
    } catch {
      setStatus('Copy failed. Open “Show LNURL for manual copy” below.');
    }
  });

  shareButton?.addEventListener('click', async () => {
    const value = shareButton.dataset.lnurl ?? '';
    if (!navigator.share) {
      try {
        await navigator.clipboard.writeText(value);
        setStatus('Sharing is not supported here. LNURL was copied for your Lightning wallet instead.');
      } catch {
        setStatus('Sharing is not supported here. Use the manual LNURL below in a Lightning wallet.');
      }
      return;
    }
    try {
      await navigator.share({ title: 'Support DAJC.eu with Lightning', text: value });
      setStatus('LNURL shared. Choose a Lightning wallet if available.');
    } catch (error) {
      if (error instanceof DOMException && error.name === 'AbortError') return;
      setStatus('Could not open the share sheet. Use “Copy for Lightning wallet” instead.');
    }
  });

  copyBtcButton?.addEventListener('click', async () => {
    const value = copyBtcButton.dataset.address ?? '';
    try {
      await navigator.clipboard.writeText(value);
      if (btcStatus) btcStatus.textContent = 'Bitcoin address copied. Verify it in your wallet before sending.';
    } catch {
      if (btcStatus) btcStatus.textContent = 'Copy failed. Select the Bitcoin address above and copy it manually.';
    }
  });
</script>

<style>
  .support {
    position: relative;
    z-index: 2;
    width: min(1040px, calc(100% - 3rem));
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) 0 6rem;
  }

  .eyebrow,
  .method {
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.18em;
    color: var(--dajc-orange);
  }

  .eyebrow { margin: 0 0 1rem; font-size: 12px; }
  .method { display: block; margin: 0 0 0.65rem; font-size: 11px; }

  h1,
  h2 { font-family: 'Space Grotesk', sans-serif; color: var(--dajc-white); }
  h1 { margin: 0 0 1.2rem; font-size: clamp(2.2rem, 6vw, 4rem); max-width: 900px; }
  h2 { margin: 0 0 0.8rem; }

  .lead,
  .method-card p,
  .details p,
  .warning { color: var(--dajc-muted); line-height: 1.75; }
  .lead { max-width: 760px; margin: 0 0 2.5rem; }

  .method-grid { display: grid; gap: 1rem; }
  .method-card {
    border: 1px solid var(--dajc-line);
    background: rgba(255,255,255,0.03);
    border-radius: 10px;
  }

  .revolut-method {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .revolut-method h2 { margin-bottom: 0.55rem; }
  .revolut-method p:last-child { margin-bottom: 0; }

  .payment-details { padding: 0; overflow: hidden; }
  .payment-details > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .payment-details > summary::-webkit-details-marker { display: none; }
  .payment-details > summary strong {
    display: block;
    color: var(--dajc-white);
    font: 700 clamp(1.3rem, 3vw, 1.7rem) 'Space Grotesk', sans-serif;
  }
  .payment-details > summary small {
    display: block;
    margin-top: 0.35rem;
    color: var(--dajc-muted);
    font: 12px/1.5 'IBM Plex Mono', monospace;
  }

  .method-action {
    flex: 0 0 auto;
    width: 92px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 1px solid var(--dajc-orange);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    color: var(--dajc-dark);
    background: var(--dajc-orange);
    font: 600 12px 'IBM Plex Mono', monospace;
    text-decoration: none;
  }
  .payment-details[open] .summary-action::after { content: ' details'; }

  .detail-content {
    padding: 0 clamp(1.25rem, 4vw, 2rem) clamp(1.25rem, 4vw, 2rem);
    border-top: 1px solid var(--dajc-line);
  }
  .lightning-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: center;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }
  .button {
    appearance: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--dajc-orange);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font: 500 13px 'IBM Plex Mono', monospace;
    text-decoration: none;
    cursor: pointer;
  }
  .primary { background: var(--dajc-orange); color: var(--dajc-dark); }
  .secondary { background: transparent; color: var(--dajc-orange); }
  .tertiary { border-color: var(--dajc-line); background: transparent; color: var(--dajc-muted); }
  .button:hover,
  .button:focus-visible,
  .method-action:hover,
  .method-action:focus-visible { transform: translateY(-1px); }

  .status { min-height: 1.4em; margin-top: 0.8rem; font: 12px 'IBM Plex Mono', monospace; }
  .warning {
    margin-top: 1rem;
    padding: 1rem;
    border-left: 2px solid var(--dajc-orange);
    background: rgba(0, 38, 92, 0.16);
    font-size: 13px;
  }
  .warning--strong strong { color: var(--dajc-white); }

  .manual { margin-top: 0.9rem; color: var(--dajc-muted); font: 12px 'IBM Plex Mono', monospace; }
  .manual summary { cursor: pointer; color: var(--dajc-orange); }
  .manual code,
  .address-box code {
    display: block;
    margin-top: 0.8rem;
    padding: 0.9rem;
    border: 1px solid var(--dajc-line);
    background: rgba(0, 0, 0, 0.18);
    color: var(--dajc-white);
    overflow-wrap: anywhere;
    user-select: all;
    font-family: 'IBM Plex Mono', monospace;
  }

  .address-box { max-width: 760px; margin-top: 1.25rem; }
  .payment-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1rem;
    margin-top: 1rem;
    color: var(--dajc-muted);
    font: 11px/1.6 'IBM Plex Mono', monospace;
  }

  .qr-wrap { text-align: center; }
  .qr-wrap img { display: block; width: min(100%, 320px); height: auto; margin: 0 auto; background: white; padding: 0.75rem; }
  .qr-wrap p { margin: 0.7rem 0 0; font: 12px 'IBM Plex Mono', monospace; }

  .details { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--dajc-line); }
  .details p { max-width: 820px; font-size: 14px; }
  .details a { color: var(--dajc-orange); }

  @media (max-width: 760px) {
    .support { width: min(100% - 2rem, 1040px); padding-top: 3rem; }
    .revolut-method,
    .payment-details > summary { align-items: flex-start; }
    .lightning-layout { grid-template-columns: 1fr; }
    .qr-wrap { order: -1; }
    .actions { flex-direction: column; }
    .button { width: 100%; }
    .payment-meta { grid-template-columns: 1fr; }
    .method-action { width: 92px; min-width: 92px; }
  }
</style>
