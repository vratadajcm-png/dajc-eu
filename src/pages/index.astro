---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeRedesign from '../components/HomeRedesign.astro';
import NewsSection from '../components/NewsSection.astro';
import { getCollection } from 'astro:content';
import { compareNewsEntries, isNewsEntryPublic, NEWS_PAGE_CACHE_CONTROL } from '../config/news';

export const prerender = false;
Astro.response.headers.set('Cache-Control', NEWS_PAGE_CACHE_CONTROL);

const now = new Date();
const euOversize = await getCollection('eu-oversize', ({ data }) => isNewsEntryPublic(data, now));
const platform = await getCollection('platform', ({ data }) => data.status === 'published');
const latestNews = [...euOversize, ...platform].sort(compareNewsEntries).slice(0, 3);
const hasPublishedEuOversize = euOversize.length > 0;
---
<BaseLayout
  title="DAJC | European Heavy Transport Platform & Vehicle Assistance Coordination"
  description="DAJC develops provider-neutral heavy and oversized transport coordination and researches a separate vehicle-assistance coordination concept for Europe."
>
  <HomeRedesign />
  <NewsSection items={latestNews} showEuOversizeLaunchNotice={!hasPublishedEuOversize} />
</BaseLayout>
