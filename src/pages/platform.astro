---
// Platform and its development material are intentionally not public.
// Keep this route server-rendered so direct URLs run through the request gate.
export const prerender = false;
return new Response(null, {
  status: 302,
  headers: { Location: '/', 'X-Robots-Tag': 'noindex, nofollow, noarchive, nosnippet', 'Cache-Control': 'no-store' },
});
