---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdatesSignup from '../components/UpdatesSignup.astro';
---
<BaseLayout title="Launch notifications and updates — DAJC" description="Request one launch notification or ongoing DAJC updates, separately from registration and commercial services.">
<main class="public-info">
  <p class="eyebrow">STAY INFORMED</p>
  <h1>Choose the updates you want.</h1>
  <p>DAJC Platform and DAJC TAR are still in development. Signing up for updates is not a testing registration, order or purchase. No commercial launch date has been confirmed.</p>
  <UpdatesSignup />
  <p>Any request is limited to the purpose you choose. Please see our <a href="/privacy">privacy notice</a>.</p>
  <p><a href="https://www.dajc.cz/" lang="cs">Česky · DAJC.cz →</a></p>
</main>
</BaseLayout>
<style>
.public-info{position:relative;z-index:2;width:min(1000px,calc(100% - 3rem));margin:4rem auto 5rem;color:var(--dajc-white)}
h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,5vw,3rem)}
p{color:var(--dajc-muted);line-height:1.8}
a,.eyebrow{color:var(--dajc-orange)}
:where(a):focus-visible{outline:2px solid var(--dajc-orange);outline-offset:4px}
</style>
