---
import BaseLayout from '../layouts/BaseLayout.astro';
const launch = 'mailto:team@dajc.eu?subject=' + encodeURIComponent('DAJC launch notification request') + '&body=' + encodeURIComponent('Please notify me once when DAJC launches commercially. I consent to the use of this email address for that one notification. This is not a request for a regular newsletter. I can withdraw this request by emailing team@dajc.eu.');
const newsletter = 'mailto:team@dajc.eu?subject=' + encodeURIComponent('DAJC newsletter request') + '&body=' + encodeURIComponent('I would like to receive DAJC project updates by email. I consent to the use of this email address for these updates until I unsubscribe. I can unsubscribe at any time by emailing team@dajc.eu.');
---
<BaseLayout title="Launch notifications and updates — DAJC" description="Request a launch notification or DAJC project updates without registering for testing.">
<main class="public-info"><p class="eyebrow">STAY INFORMED</p><h1>Choose the updates you want.</h1><p>You can ask for news without joining Testing 2027. The commercial launch date is not confirmed.</p><section><h2>One launch notification</h2><p>Receive a single email when the commercial launch is announced. This does not subscribe you to ongoing updates.</p><a href={launch}>Prepare a launch notification request →</a></section><section><h2>Project newsletter</h2><p>Ask to receive ongoing DAJC project updates. Requests are handled manually by the DAJC team, who will confirm your subscription.</p><a href={newsletter}>Prepare a newsletter request →</a></section><p>Each button opens a draft in your email app. Review and send it yourself; clicking does not send anything or automatically subscribe you. Your email is used only for the selected purpose. To withdraw your request or unsubscribe, email <a href="mailto:team@dajc.eu?subject=Unsubscribe">team@dajc.eu</a> with “Unsubscribe”. See our <a href="/privacy">privacy notice</a>.</p><p><a href="https://www.dajc.cz/kontakt" lang="cs">Český formulář žádosti →</a></p></main>
</BaseLayout>
<style>.public-info{position:relative;z-index:2;width:min(800px,calc(100% - 3rem));margin:4rem auto 5rem;color:var(--dajc-white)}h1{font-size:clamp(2rem,5vw,3rem)}h2{font-size:1.5rem}p{color:#b7c8db;line-height:1.8}section{padding:1.5rem 0;border-bottom:1px solid var(--dajc-line)}a,.eyebrow{color:var(--dajc-orange)}a{display:inline-block;min-height:44px;padding:.4rem 0}a:focus-visible{outline:2px solid var(--dajc-orange);outline-offset:4px}</style>
