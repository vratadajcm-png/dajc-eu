---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDrivingBansSnapshot } from '../../config/driving-ban-calendars/runtime.mjs';
export const prerender = false;
const view = getDrivingBansSnapshot();
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'no-store');
const cs = Astro.url.searchParams.get('lang') === 'cs';
const label = (en: string, cz: string) => cs ? cz : en;
const title = label('European HGV Driving Bans', 'Evropské zákazy jízd nákladních vozidel');
const format = (value: string | null) => value ? new Intl.DateTimeFormat(cs ? 'cs-CZ' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Prague' }).format(new Date(value)) : label('Not completed', 'Nedokončeno');
const count = (state: string) => view.jurisdictions.filter(j => j.ban_state === state).length;
const eventsByCountry = new Map<string, typeof view.events>(view.jurisdictions.map(j => [j.jurisdiction, view.events.filter(e => e.jurisdiction === j.jurisdiction)]));
type Weight = { any_of?: Weight[]; all_of?: Weight[]; operator?: string; value?: number; unit?: string; applies_to?: string };
const weightText = (w: Weight): string => w.any_of ? w.any_of.map(weightText).join(label(' OR ', ' NEBO ')) : w.all_of ? w.all_of.map(weightText).join(label(' AND ', ' A ')) : w.operator === 'any' ? `${w.applies_to} (${label('any mass', 'bez hmotnostní hranice')})` : `${w.applies_to} ${w.operator} ${w.unit === 'kg' ? `${(w.value ?? 0) / 1000} t` : `${w.value} ${w.unit}`}`;
const statusText = (j: typeof view.jurisdictions[number]) => j.ban_state === 'NO_BAN' ? label('No driving bans', 'Bez zákazu') : j.ban_state === 'HAS_BAN' ? label(`${j.event_count} verified events in this period`, `${j.event_count} ověřených událostí v období`) + (j.coverage_complete ? '' : label(' · review incomplete', ' · ověření neúplné')) : label('Verification in progress', 'Ověření probíhá');
---
<BaseLayout title={title} description={`Verified HGV restrictions and explicit verification status for ${view.jurisdictions.length} DAJC jurisdictions. Current and next calendar month.`}>
  <section class="bans-page" data-window={view.window.from}>
    <header>
      <p class="eyebrow">DAJC INTELLIGENCE</p>
      <h1>{title}</h1>
      <p>{label('Coverage period', 'Sledované období')}: <strong>{view.window.from} — {view.window.to}</strong></p>
      <p>{label('Exact thresholds, local times, roads and exceptions matter. A restriction above 12 t is not a blanket restriction above 7.5 t.', 'Rozhodují přesné hmotnostní limity, místní časy, komunikace a výjimky. Zákaz nad 12 t není plošný zákaz nad 7,5 t.')}</p>
      <a href={cs ? '/driving-bans' : '/driving-bans?lang=cs'}>{cs ? 'English' : 'Česky'}</a>
    </header>
    <aside class="notice" role="note">
      <strong>{label(`${view.jurisdictions.length} tracked jurisdictions does not mean ${view.jurisdictions.length} verified jurisdictions.`, `${view.jurisdictions.length} sledovaných jurisdikcí neznamená ${view.jurisdictions.length} ověřených jurisdikcí.`)}</strong>
      <p>{label('Verified individual bans can be available while the full country review is incomplete. Missing events never mean unrestricted travel. “No driving bans” is shown only after a complete primary-source review of this entire period.', 'Jednotlivé zákazy mohou být ověřené, i když celková kontrola země není dokončena. Chybějící události nikdy neznamenají volný průjezd. „Bez zákazu“ se zobrazí pouze po úplném ověření celého období z primárních zdrojů.')}</p>
      <p>{label('Scheduled full review: Thursday. Urgent changes may trigger a targeted recheck. Always confirm the current official source and your transport permit before departure.', 'Plánovaná úplná kontrola: čtvrtek. Naléhavá změna může vyvolat cílené ověření. Před jízdou vždy zkontrolujte aktuální úřední zdroj a své povolení.')}</p>
    </aside>
    <p class="stats">{view.jurisdictions.length} / {view.jurisdictions.length} {label('tracked', 'sledováno')} · {count('HAS_BAN')} HAS_BAN · {count('NO_BAN')} NO_BAN · {count('UNKNOWN')} UNKNOWN · {view.jurisdictions.filter(j => j.coverage_complete).length} / {view.jurisdictions.length} {label('fully verified', 'úplně ověřeno')}</p>
    <details class="small"><summary>{label(`Not covered by Driving Bans (${view.scope.excluded.length} territories)`, `Mimo rozsah Driving Bans (${view.scope.excluded.length} území)`)}</summary><p>{label('No verifiable primary source on HGV driving bans exists for these overseas, remote or disputed territories. DAJC publishes no status for them; this is not a “no ban” statement.', 'Pro tato zámořská, odlehlá či sporná území neexistuje ověřitelný primární zdroj k zákazům jízd nákladních vozidel. DAJC pro ně nezveřejňuje žádný stav; nejde o tvrzení „Bez zákazu“.')}</p><p>{view.scope.excluded.map(x => `${x.name} (${x.jurisdiction})`).join(', ')}</p></details>
    <form id="ban-filters" class="controls">
      <label>{label('Find a jurisdiction', 'Vyhledat jurisdikci')} <input id="country-search" type="search" placeholder={label('Name or code', 'Název nebo kód')} /></label>
      <label>{label('Restrictions', 'Omezení')} <select id="ban-type"><option value="all">{label('All HGV / exceptional', 'Všechny nákladní / nadrozměrné')}</option><option value="general">{label('General HGV', 'Běžná nákladní vozidla')}</option><option value="exceptional">{label('Exceptional, including relevant HGV bans', 'Nadměrné, včetně příslušných běžných zákazů')}</option></select></label>
      <label><input id="include-history" type="checkbox" /> {label('Include past events within the coverage period', 'Zobrazit i uplynulé události sledovaného období')}</label>
      <details class="selection"><summary>{label('Select jurisdictions for the calendar', 'Výběr jurisdikcí pro kalendář')}</summary>
        <button type="button" id="select-all">{label('Select all', 'Vybrat vše')}</button> <button type="button" id="clear-all">{label('Clear selection', 'Zrušit výběr')}</button>
        <div class="country-grid">{view.jurisdictions.map(j => <label><input type="checkbox" name="country" value={j.jurisdiction} checked /> {j.name} ({j.jurisdiction})</label>)}</div>
      </details>
      <p><a id="ics-link" class="calendar-link" href="/api/driving-bans.ics?rolling=1">{label('Subscribe / open ICS calendar', 'Odebírat / otevřít ICS kalendář')}</a> · <a href="/api/driving-bans.json">{label('Canonical JSON / verification evidence', 'Jednotná data JSON / doklady ověření')}</a></p>
      <p class="small">{label('ICS contains actual verified ban events only, by default excluding events that have already ended. Empty calendars are not a NO_BAN decision. Existing calendar applications may retain earlier cached events until they refresh.', 'ICS obsahuje pouze skutečné ověřené zákazy; ve výchozím stavu nezahrnuje ukončené události. Prázdný kalendář není potvrzením „Bez zákazu“. Kalendářové aplikace mohou staré události uchovat do další obnovy.')}</p>
    </form>
    <div id="jurisdictions">
      {view.jurisdictions.map(j => <details class="jurisdiction" data-code={j.jurisdiction} data-name={j.name.toLowerCase()} data-ban-state={j.ban_state} data-verification-state={j.verification_state}>
        <summary><strong>{j.name}</strong> <span class="code">{j.jurisdiction}</span> <span class="status">{statusText(j)}</span></summary>
        <div class="country-body">
          <p>{label('Period', 'Období')}: {j.period.from} — {j.period.to}. <strong>{j.verification_state}</strong></p>
          <p>{label('Last checked', 'Poslední kontrola')}: {format(j.last_checked)} · {label('Full-period verification', 'Ověření celého období')}: {format(j.last_verified)}</p>
          {!j.coverage_complete && <p class="notice">{label('Full jurisdiction verification is incomplete. Additional restrictions may exist; do not interpret missing events as “no ban”.', 'Ověření celé jurisdikce není dokončeno. Mohou existovat další omezení; chybějící události neznamenají „Bez zákazu“.')}</p>}
          {j.coverage_failures.length > 0 && <p class="small">{label('Open review items', 'Otevřené body ověření')}: {j.coverage_failures.join(', ')}</p>}
          {j.notes && <p class="small">{j.notes}</p>}
          {j.ban_state === 'NO_BAN' && <p><strong>{label('No driving bans', 'Bez zákazu')}</strong> — {j.period.from} — {j.period.to} · {label('verified', 'ověřeno')} {format(j.last_verified)}</p>}
          <p class="sources">{j.source_ids.map(id => { const source = view.sources.find(s => s.source_id === id); return source && <a href={source.url} target="_blank" rel="noopener noreferrer">{source.authority}</a>; })}</p>
          <div class="events">{(eventsByCountry.get(j.jurisdiction) || []).map(e => <article class="ban-event" data-ends={e.ends_at} data-types={e.restriction_types.join(',')} data-uid={e.uid}>
            <h3>{e.title}</h3>
            <p><strong>{e.date} {e.start_time} — {e.end_date} {e.end_time}</strong> ({e.timezone})</p>
            <p>{e.vehicle_scope}</p><p><strong>{label('Applicability', 'Hmotnostní/technická kritéria')}:</strong> {weightText(e.weight_threshold)}</p><p>{e.roads.join('; ')} · {e.regions.join('; ')} · {e.direction}</p>
            <p><strong>{label('Exceptions', 'Výjimky')}:</strong> {e.exceptions.join(' ')}</p>
            <p><strong>ADR:</strong> {e.adr_relevance}</p><p><strong>Exceptional / oversize:</strong> {e.exceptional_relevance}</p>
            <p>{e.notes}</p>
            <p class="small"><a href={e.source_url} target="_blank" rel="noopener noreferrer">{e.source_authority}</a> · {e.source_version} · {label('Rule verified', 'Pravidlo ověřeno')}: {format(e.verified_at)}</p>
          </article>)}</div>
        </div>
      </details>)}
    </div>
    <p class="small">{label('Dataset version', 'Verze dat')}: {view.dataset_version}. {label('Generated', 'Vygenerováno')}: {format(view.generated_at)}.</p>
  </section>
</BaseLayout>
<script>
  const init = () => {
    const form = document.querySelector<HTMLFormElement>('#ban-filters');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="country"]')];
    const search = form.querySelector<HTMLInputElement>('#country-search')!;
    const type = form.querySelector<HTMLSelectElement>('#ban-type')!;
    const history = form.querySelector<HTMLInputElement>('#include-history')!;
    const link = form.querySelector<HTMLAnchorElement>('#ics-link')!;
    const update = () => {
      const selected = boxes.filter(b => b.checked).map(b => b.value);
      document.querySelectorAll<HTMLElement>('.jurisdiction').forEach(row => {
        const code = row.dataset.code || '';
        row.hidden = !selected.includes(code) || !`${row.dataset.name} ${code}`.toLowerCase().includes(search.value.toLowerCase());
      });
      document.querySelectorAll<HTMLElement>('.ban-event').forEach(e => {
        e.hidden = (!history.checked && (e.dataset.ends || '') <= new Date().toISOString()) || (type.value === 'general' && !e.dataset.types?.split(',').includes('general'));
      });
      const params = new URLSearchParams({ rolling: '1', type: type.value });
      if (selected.length && selected.length !== boxes.length) params.set('countries', selected.join(','));
      if (history.checked) params.set('history', '1');
      if (selected.length) { link.href = `/api/driving-bans.ics?${params}`; link.removeAttribute('aria-disabled'); }
      else { link.removeAttribute('href'); link.setAttribute('aria-disabled', 'true'); }
    };
    form.addEventListener('submit', e => e.preventDefault());
    form.addEventListener('input', update);
    form.querySelector('#select-all')?.addEventListener('click', () => { boxes.forEach(b => b.checked = true); update(); });
    form.querySelector('#clear-all')?.addEventListener('click', () => { boxes.forEach(b => b.checked = false); update(); });
    update();
  };
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) return;
    const stored = document.querySelector<HTMLElement>('[data-window]')?.dataset.window;
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague', year: 'numeric', month: '2-digit' }).formatToParts(new Date());
    const month = `${parts.find(p => p.type === 'year')?.value}-${parts.find(p => p.type === 'month')?.value}-01`;
    if (stored && stored !== month) location.reload();
  });
</script>
<style>
  .bans-page { max-width: 1160px; margin: 0 auto; padding: 3rem 1.2rem; }
  .eyebrow { font-size: .8rem; letter-spacing: .16em; font-weight: 700; }
  h1 { font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.15; }
  .notice { border-left: 4px solid #edb74c; background: #edb74c14; padding: 1rem 1.2rem; margin: 1.3rem 0; }
  .controls, .jurisdiction { border: 1px solid #71809666; border-radius: 10px; padding: 1rem; margin: .9rem 0; }
  .controls > label { display: block; margin: .65rem 0; }
  input[type=search], select { color: inherit; background: transparent; border: 1px solid #718096; border-radius: 5px; padding: .5rem; max-width: 100%; }
  select option { color: #111; }
  button { padding: .45rem .8rem; margin: .5rem .2rem; border: 1px solid #718096; border-radius: 5px; }
  summary { cursor: pointer; line-height: 1.8; }
  .status { margin-left: .7rem; font-size: .9rem; }
  .code, .small { font-size: .85rem; opacity: .8; }
  .country-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(235px, 1fr)); gap: .45rem; padding: 1rem 0; }
  .country-body { padding: .75rem .2rem; }
  .ban-event { border-top: 1px solid #71809655; padding: .8rem 0; }
  .ban-event h3 { font-size: 1.1rem; }
  .sources a { display: inline-block; margin: .25rem .7rem .25rem 0; }
  .calendar-link[aria-disabled=true] { opacity: .5; pointer-events: none; }
  [hidden] { display: none !important; }
  p { overflow-wrap: anywhere; }
</style>
