---
import { getCollection } from 'astro:content';
import ArticleDetail from '../../../components/ArticleDetail.astro';
import NewsNotFound from '../../../components/NewsNotFound.astro';
import { isNewsEntryPublic, NEWS_PAGE_CACHE_CONTROL, newsCategoryLabel } from '../../../config/news';

// Rendered on demand (CDN-cached) instead of prerendered: the weekly article
// is committed ahead of its Friday 12:00 Europe/Prague slot and must appear
// exactly then, without depending on a rebuild at that moment.
export const prerender = false;

const now = new Date();
const entry = (await getCollection('eu-oversize', ({ data }) => isNewsEntryPublic(data, now))).find(
  (candidate) => candidate.data.slug === Astro.params.slug
);

Astro.response.headers.set('Cache-Control', NEWS_PAGE_CACHE_CONTROL);
// A missing, upcoming or withdrawn edition is a 404 inside the site layout,
// with a way back to the archive (links shared on X/LinkedIn land here).
if (!entry) Astro.response.status = 404;
---
{entry ? <ArticleDetail entry={entry} categoryLabel={newsCategoryLabel('eu-oversize', entry.data.slug)} /> : <NewsNotFound />}
