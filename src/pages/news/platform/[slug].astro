---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleDetail from '../../../components/ArticleDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('platform', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'platform'>;
}

const { entry } = Astro.props;
---
<ArticleDetail entry={entry} categoryLabel="DAJC Platform Updates" />
