---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import EuOversizeLaunchNotice from '../../components/EuOversizeLaunchNotice.astro';
import { getCollection } from 'astro:content';

const euOversize = await getCollection('eu-oversize', ({ data }) => data.status === 'published');
const platform = await getCollection('platform', ({ data }) => data.status === 'published');

const allNews = [...euOversize, ...platform].sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const hasPublishedEuOversize = euOversize.length > 0;
const hasPublishedPlatform = platform.length > 0;
---
<BaseLayout
  title="News - DAJC"
  description="EU Oversize Weekly briefings and DAJC Platform Updates in one place."
>
  <main class="news-page">
    <p class="eyebrow">DAJC News</p>
    <h1>Latest updates</h1>
    <p class="news-page__intro">EU Oversize Weekly briefings and DAJC Platform Updates in one place.</p>

    <div class="news-filters" role="tablist" aria-label="Filter news by category">
      <button type="button" class="news-filter is-active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="news-filter" data-filter="eu-oversize" role="tab" aria-selected="false">EU Oversize</button>
      <button type="button" class="news-filter" data-filter="platform" role="tab" aria-selected="false">Platform Updates</button>
    </div>

    {allNews.length > 0 || !hasPublishedEuOversize ? (
      <div class="news-grid">
        {!hasPublishedEuOversize && (
          <div class="news-grid__item" data-category="eu-oversize">
            <EuOversizeLaunchNotice />
          </div>
        )}
        {allNews.map((item) => (
          <div class="news-grid__item" data-category={item.collection}>
            <NewsCard entry={item} />
          </div>
        ))}
      </div>
    ) : (
      <p class="news-empty">No published articles yet - check back soon.</p>
    )}

    {!hasPublishedPlatform && (
      <p class="news-empty news-filter-empty" data-filter-empty="platform" hidden>
        No Platform Updates published yet - check back soon.
      </p>
    )}
  </main>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.news-filter');
  const items = document.querySelectorAll<HTMLElement>('.news-grid__item');
  const platformEmpty = document.querySelector<HTMLElement>('[data-filter-empty="platform"]');
  // Presence, not current visibility - the eu-oversize launch notice already
  // covers the "eu-oversize" and "all" filters (see EuOversizeLaunchNotice),
  // so this only needs to handle "Platform Updates" having nothing to show.
  const hasPlatformItems = document.querySelectorAll('[data-category="platform"]').length > 0;

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.dataset.filter;
      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.category === filter;
        item.style.display = show ? '' : 'none';
      });

      if (platformEmpty) {
        platformEmpty.hidden = !(filter === 'platform' && !hasPlatformItems);
      }
    });
  });
</script>

<style>
  .news-page {
    position: relative;
    z-index: 2;
    max-width: 960px;
    margin: 0 auto;
    padding: 8vh 1.5rem 8vh;
  }

  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dajc-orange);
    margin: 0 0 1.2rem;
    text-align: center;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--dajc-white);
    text-align: center;
  }

  .news-page__intro {
    font-size: 16px;
    line-height: 1.75;
    color: var(--dajc-muted);
    max-width: 56ch;
    margin: 0 auto 2.4rem;
    text-align: center;
  }

  .news-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.6rem;
  }

  .news-filter {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dajc-muted);
    background: transparent;
    border: 1px solid var(--dajc-line);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .news-filter:hover {
    color: var(--dajc-white);
  }

  .news-filter.is-active {
    color: var(--dajc-dark);
    background: var(--dajc-orange);
    border-color: var(--dajc-orange);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    align-items: stretch;
  }

  .news-empty {
    text-align: center;
    color: var(--dajc-muted);
    font-size: 14px;
  }

  .news-filter-empty {
    margin-top: 1.6rem;
  }

  @media (max-width: 820px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .news-grid {
      grid-template-columns: 1fr;
    }

    .news-page {
      padding: 6vh 1.2rem 6vh;
    }
  }
</style>
