---
// Ask DAJC AI (DAJC Intelligence, master plan §47, Phase 1). Rendered on
// demand so it can answer 404 while DAJC_ASK_ENABLED is not "true" or the
// configuration is incomplete; never indexed during Phase 1.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAskConfig } from '../../lib/ask/config';
import { getAccountRuntime } from '../../lib/ask/account/runtime';
import { dictionary, t, uiLangFromRequest } from '../../lib/ask/i18n';

export const prerender = false;

if (!getAskConfig()) {
  return new Response('Not found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store', 'X-Robots-Tag': 'noindex, nofollow, noarchive' },
  });
}

const lang = uiLangFromRequest(Astro.url, Astro.request.headers.get('accept-language'));
const strings = dictionary(lang);
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const otherLang = lang === 'cs' ? 'en' : 'cs';
// The account panel (consents, memory, history, subscription) exists only when
// DAJC_AI_ACCOUNT_ENABLED is on; paid parts show only for an active subscription.
const accountOn = getAccountRuntime() !== null;
const vehicleConfigurations = ['SOLO', 'TRUCK_TRAILER', 'ARTICULATED', 'TRACTOR_ONLY', 'OTHER'];
---
<BaseLayout title={`${t(lang, 'pageTitle')} — DAJC Intelligence`} description={t(lang, 'pageDescription')} robots="noindex, nofollow" lang={lang}>
  <main class="ask" data-ask-root data-lang={lang} data-strings={JSON.stringify(strings)}>
    <p class="eyebrow">DAJC INTELLIGENCE · BETA</p>
    <h1>{t(lang, 'pageTitle')}</h1>
    <p class="lead">{t(lang, 'intro')}</p>
    <p class="info-only">{t(lang, 'infoOnly')}</p>
    <p class="lang-switch"><a href={`?lang=${otherLang}`}>{otherLang === 'cs' ? 'Česky' : 'English'}</a></p>

    <p class="ask-message" data-ask="message" role="status" aria-live="polite"></p>

    <section data-ask="confirm" hidden>
      <h2>{t(lang, 'confirmTitle')}</h2>
      <button type="button" class="button">{t(lang, 'confirmButton')}</button>
    </section>

    <section data-ask="sign-in" hidden>
      <p>{t(lang, 'signInIntro')}</p>
      <form>
        <label>{t(lang, 'emailLabel')}<input type="email" name="email" required maxlength="254" autocomplete="email" /></label>
        <button type="submit" class="button">{t(lang, 'sendLink')}</button>
      </form>
    </section>

    <section data-ask="ask" hidden>
      <form>
        <label>{t(lang, 'questionLabel')}<textarea name="question" required minlength="5" maxlength="1000" rows="4"></textarea></label>
        <p class="hint">{t(lang, 'questionHint')}</p>
        {accountOn && (
          <fieldset class="paid-fields" data-ask="paid-fields" hidden>
            <legend>{t(lang, 'paid.title')}</legend>
            <label>{t(lang, 'paid.vehicle')}<select data-ask="vehicle"><option value="">{t(lang, 'paid.none')}</option></select></label>
            <label>{t(lang, 'paid.countries')}<input type="text" data-ask="countries" maxlength="80" autocomplete="off" pattern="[A-Za-z, ;]*" /></label>
            <label>{t(lang, 'paid.date')}<input type="date" data-ask="date" /></label>
          </fieldset>
        )}
        <button type="submit" class="button">{t(lang, 'submit')}</button>
      </form>
      <p class="remaining" data-ask="remaining"></p>
      <div class="answer" data-ask="answer" aria-live="polite"></div>
      <button type="button" class="link-button" data-ask="sign-out">{t(lang, 'signOut')}</button>
    </section>

    {accountOn && (
      <section class="account" data-account-panel hidden aria-labelledby="account-title">
        <h2 id="account-title">{t(lang, 'acct.title')}</h2>
        <p class="ask-message" data-account="message" role="status" aria-live="polite"></p>
        <div data-account="subscription"></div>

        <h3>{t(lang, 'consent.title')}</h3>
        <div class="consents" data-account="consents"></div>

        <div data-paid-only hidden>
          <h3>{t(lang, 'mem.title')}</h3>
          <ul class="plain-list" data-account="memory-list"></ul>
          <form class="grid-form" data-account="memory-form">
            <label>{t(lang, 'mem.name')}<input name="name" required maxlength="80" /></label>
            <label>{t(lang, 'mem.configuration')}
              <select name="configuration">{vehicleConfigurations.map((c) => <option value={c}>{t(lang, `mem.cfg.${c}` as never)}</option>)}</select>
            </label>
            <label>{t(lang, 'mem.mass')}<input name="mass" inputmode="decimal" /></label>
            <label>{t(lang, 'mem.width')}<input name="width" inputmode="decimal" /></label>
            <label>{t(lang, 'mem.height')}<input name="height" inputmode="decimal" /></label>
            <label>{t(lang, 'mem.length')}<input name="length" inputmode="decimal" /></label>
            <label class="inline"><input type="checkbox" name="adr" /> {t(lang, 'mem.adr')}</label>
            <label class="inline"><input type="checkbox" name="exceptional" /> {t(lang, 'mem.exceptional')}</label>
            <button type="submit" class="button">{t(lang, 'mem.add')}</button>
          </form>

          <h3>{t(lang, 'permit.title')}</h3>
          <p class="hint">{t(lang, 'permit.intro')}</p>
          <form class="grid-form" data-account="permit-form">
            <fieldset>
              <legend>{t(lang, 'permit.permitSide')}</legend>
              <label>{t(lang, 'mem.length')}<input name="maxLength" inputmode="decimal" /></label>
              <label>{t(lang, 'mem.width')}<input name="maxWidth" inputmode="decimal" /></label>
              <label>{t(lang, 'mem.height')}<input name="maxHeight" inputmode="decimal" /></label>
              <label>{t(lang, 'mem.mass')}<input name="maxMass" inputmode="decimal" /></label>
              <label>{t(lang, 'permit.validTo')}<input name="validTo" type="date" /></label>
            </fieldset>
            <fieldset>
              <legend>{t(lang, 'permit.transportSide')}</legend>
              <label>{t(lang, 'mem.length')}<input name="length" inputmode="decimal" /></label>
              <label>{t(lang, 'mem.width')}<input name="width" inputmode="decimal" /></label>
              <label>{t(lang, 'mem.height')}<input name="height" inputmode="decimal" /></label>
              <label>{t(lang, 'mem.mass')}<input name="mass" inputmode="decimal" /></label>
              <label>{t(lang, 'paid.date')}<input name="date" type="date" /></label>
            </fieldset>
            <button type="submit" class="button">{t(lang, 'permit.compare')}</button>
          </form>
          <div data-account="permit-result" aria-live="polite"></div>

          <h3>{t(lang, 'hist.title')}</h3>
          <ul class="plain-list" data-account="history-list"></ul>
          <button type="button" class="link-button" data-account="history-delete-all">{t(lang, 'hist.deleteAll')}</button>
        </div>

        <h3>{t(lang, 'data.title')}</h3>
        <p><a href="/api/ask/account/export" download>{t(lang, 'data.export')}</a></p>
        <button type="button" class="link-button danger" data-account="delete">{t(lang, 'data.delete')}</button>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  import { initAskForm } from '../../lib/ask/client/ask-form';
  import { initAccountPanel } from '../../lib/ask/client/account-panel';
  initAskForm();
  initAccountPanel();
</script>

<style>
  .ask {
    position: relative;
    z-index: 2;
    width: min(820px, calc(100% - 3rem));
    margin: 0 auto;
    padding: clamp(4rem, 9vw, 7rem) 0 6rem;
    color: var(--dajc-muted);
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--dajc-orange);
  }
  h1, h2, h3 {
    font-family: 'Space Grotesk', sans-serif;
    color: var(--dajc-white);
  }
  h1 { margin: 0 0 1.2rem; font-size: clamp(2rem, 5vw, 3rem); }
  .lead, .info-only, .hint, .remaining { line-height: 1.7; }
  .info-only { font-size: 14px; border-left: 2px solid var(--dajc-orange); padding-left: 0.8rem; }
  section { padding: 1.4rem 0; border-top: 1px solid var(--dajc-line); }
  label { display: grid; gap: 0.5rem; color: var(--dajc-white); }
  input, textarea {
    font: inherit;
    padding: 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--dajc-line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--dajc-white);
  }
  .button {
    margin-top: 0.8rem;
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 6px;
    background: var(--dajc-orange);
    color: #061a33;
    font-weight: 600;
    cursor: pointer;
  }
  .button[disabled] { opacity: 0.5; cursor: not-allowed; }
  .link-button { background: none; border: 0; color: var(--dajc-orange); cursor: pointer; padding: 0; margin-top: 1.5rem; }
  a { color: var(--dajc-orange); }
  .answer :global(.ask-level) {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    border: 1px solid currentColor;
  }
  .answer :global(.ask-level--verified) { color: #3ecf8e; }
  .answer :global(.ask-level--partial) { color: #f5b942; }
  .answer :global(.ask-level--unknown) { color: #ff7a7a; }
  .answer :global(.ask-level--insufficient_verified_data) { color: #ff7a7a; }
  .answer :global(.ask-unverified) { color: #f5b942; font-size: 0.9em; }
  .answer :global(.ask-outcome--insufficient_verified_data) { color: #f5b942; }
  .answer :global(.ask-statements li) { margin: 0.6rem 0; color: var(--dajc-white); line-height: 1.6; }
  .answer :global(.ask-facts) { display: grid; grid-template-columns: max-content 1fr; gap: 0.2rem 1rem; font-size: 13px; color: var(--dajc-muted); margin: 0.6rem 0; }
  .answer :global(.ask-facts dd) { margin: 0; }
  .answer :global(.ask-ai-notice) { font-family: 'IBM Plex Mono', monospace; font-size: 12px; margin-top: 1.5rem; }
  .answer :global(.ask-support) { font-size: 13px; }
  .answer :global(.ask-confidence) { font-size: 14px; color: var(--dajc-white); }
  .answer :global(.ask-registry) { margin-top: 1.5rem; padding: 1rem; border: 1px solid var(--dajc-line); border-radius: 6px; }
  .answer :global(.ask-feedback) { margin-top: 1rem; }
  .answer :global(.ask-feedback summary), .answer :global(.ask-feedback label) { cursor: pointer; color: var(--dajc-orange); }
  .answer :global(.ask-feedback form) { display: grid; gap: 0.6rem; margin-top: 0.6rem; }
  select, input[type="date"] { font: inherit; padding: 0.6rem; border-radius: 6px; border: 1px solid var(--dajc-line); background: rgba(255, 255, 255, 0.04); color: var(--dajc-white); }
  fieldset { border: 1px solid var(--dajc-line); border-radius: 6px; padding: 0.8rem; display: grid; gap: 0.6rem; margin: 0.8rem 0; }
  legend { color: var(--dajc-white); padding: 0 0.4rem; }
  .grid-form { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); align-items: end; }
  .grid-form button { justify-self: start; }
  .grid-form .inline { display: flex; align-items: center; gap: 0.5rem; }
  .plain-list { list-style: none; padding: 0; }
  .plain-list li { padding: 0.4rem 0; border-bottom: 1px solid var(--dajc-line); overflow-wrap: anywhere; }
  .consents { display: grid; gap: 0.6rem; }
  .consents :global(.ask-consent) { display: flex; gap: 0.6rem; align-items: flex-start; }
  .account :global(.ask-actions) { display: flex; flex-wrap: wrap; gap: 1rem; }
  .account :global(.ask-test-mode) { color: #f5b942; font-family: 'IBM Plex Mono', monospace; font-size: 12px; }
  .account :global(.ask-check--exceeds_permit), .account :global(.ask-permit--discrepancies_found) { color: #ff7a7a; }
  .danger { color: #ff7a7a; }
  button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible { outline: 2px solid var(--dajc-orange); outline-offset: 2px; }
  @media (max-width: 640px) {
    .ask { width: calc(100% - 2rem); padding-top: 3rem; }
    .grid-form { grid-template-columns: 1fr; }
    .answer :global(.ask-facts) { grid-template-columns: 1fr; }
    .button { width: 100%; }
  }
</style>
