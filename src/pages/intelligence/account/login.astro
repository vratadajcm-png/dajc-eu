---
export const prerender = false;

import PortalLayout from '../../../portal/components/PortalLayout.astro';
import { notFoundUnlessIntelligenceAccounts } from '../../../portal/lib/guards';
import { CUSTOMER_SESSION_SCOPE, ensureCsrfCookie, validateCsrfToken } from '../../../portal/lib/session';
import { requestCustomerLoginToken } from '../../../portal/lib/magicLink';
import { sendCustomerMagicLinkEmail } from '../../../portal/lib/email';
import { checkAndRecordRateLimit } from '../../../portal/lib/rateLimit';

const disabled = notFoundUnlessIntelligenceAccounts();
if (disabled) return disabled;

let sent = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const csrf = form.get('csrf_token');
  const email = String(form.get('email') ?? '').trim();

  if (!validateCsrfToken(Astro.cookies, typeof csrf === 'string' ? csrf : null, CUSTOMER_SESSION_SCOPE)) {
    error = 'Your session expired, please try again.';
  } else if (!email) {
    error = 'Enter your email address.';
  } else {
    const rateLimit = await checkAndRecordRateLimit(Astro.clientAddress ?? 'unknown', { action: 'customer_login_request', windowSeconds: 15 * 60, maxAttempts: 5 });
    if (!rateLimit.allowed) {
      error = 'Too many attempts. Please try again later.';
    } else {
      // Same answer whether or not the address has an account (no enumeration).
      const token = await requestCustomerLoginToken(email);
      if (token) {
        const loginUrl = new URL(`/intelligence/account/callback?token=${encodeURIComponent(token.rawToken)}`, Astro.url.origin).toString();
        await sendCustomerMagicLinkEmail({ to: email, loginUrl, expiresAt: token.expiresAt });
      }
      sent = true;
    }
  }
}

const csrfToken = ensureCsrfCookie(Astro.cookies, Astro.url, CUSTOMER_SESSION_SCOPE);
---
<PortalLayout title="Sign in" brand="DAJC Intelligence">
  <h1>DAJC Intelligence - Sign in</h1>
  {sent && <p class="flash success">If that address has a DAJC Intelligence account, a sign-in link has been sent.</p>}
  {error && <p class="flash error">{error}</p>}
  {!sent && (
    <form method="POST">
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
      <button type="submit">Send sign-in link</button>
    </form>
  )}
  <p>Accounts are set up by DAJC for subscribing companies. To subscribe, contact DAJC.</p>
</PortalLayout>
