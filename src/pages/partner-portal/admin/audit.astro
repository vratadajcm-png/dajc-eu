---
export const prerender = false;

import PortalLayout from '../../../portal/components/PortalLayout.astro';
import { notFoundIfPortalDisabled, redirectResponse } from '../../../portal/lib/guards';
import { requireAdminPrincipal } from '../../../portal/lib/session';
import { listRecentAuditEvents } from '../../../portal/lib/audit';

const disabled = notFoundIfPortalDisabled();
if (disabled) return disabled;

const admin = await requireAdminPrincipal(Astro.cookies);
if (!admin) return redirectResponse('/partner-portal/admin/login');

const partnerId = Astro.url.searchParams.get('partnerId') ?? undefined;
const events = await listRecentAuditEvents(partnerId);
---
<PortalLayout title="Audit log">
  <p><a href="/partner-portal/admin">&larr; All partners</a></p>
  <h1>Audit log {partnerId && <span class="badge">partner {partnerId.slice(0, 8)}</span>}</h1>
  <table>
    <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th></tr></thead>
    <tbody>
      {events.map((e) => (
        <tr>
          <td>{e.createdAt.toISOString()}</td>
          <td>{e.actor} ({e.actorType})</td>
          <td>{e.action}</td>
          <td>{e.targetType ?? '-'} {e.targetId?.slice(0, 8) ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
</PortalLayout>
