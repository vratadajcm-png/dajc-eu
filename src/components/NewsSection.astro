---
import type { CollectionEntry } from 'astro:content';
import NewsCard from './NewsCard.astro';

interface Props {
  items: Array<CollectionEntry<'eu-oversize'> | CollectionEntry<'platform'>>;
}

const { items } = Astro.props;
---
<section class="news-section" aria-labelledby="news-heading">
  <div class="news-section__inner">
    <div class="news-section__head">
      <p class="news-section__eyebrow">Latest updates</p>
      <h2 id="news-heading">News</h2>
    </div>

    {items.length > 0 ? (
      <div class="news-grid">
        {items.map((item) => (
          <NewsCard entry={item} />
        ))}
      </div>
    ) : (
      <p class="news-empty">No published articles yet - check back soon.</p>
    )}

    <a class="news-view-all" href="/news">View all news &rarr;</a>
  </div>
</section>

<style>
  .news-section {
    position: relative;
    z-index: 2;
    padding: 3.5rem 1.5rem 5rem;
    border-top: 1px solid var(--dajc-line);
  }

  .news-section__inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .news-section__head {
    text-align: center;
    margin-bottom: 2.2rem;
  }

  .news-section__eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dajc-orange);
    margin: 0 0 0.6rem;
  }

  .news-section__head h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    color: var(--dajc-white);
    margin: 0;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    align-items: stretch;
  }

  .news-empty {
    text-align: center;
    color: var(--dajc-muted);
    font-size: 14px;
  }

  .news-view-all {
    display: block;
    width: fit-content;
    margin: 2.2rem auto 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dajc-orange);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .news-view-all:hover {
    border-color: var(--dajc-orange);
  }

  @media (max-width: 820px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .news-grid {
      grid-template-columns: 1fr;
    }

    .news-section {
      padding: 2.6rem 1.2rem 3.2rem;
    }
  }
</style>
