---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Article not found - DAJC" description="This DAJC News article is not available.">
  <main class="news-not-found">
    <p class="eyebrow">DAJC News</p>
    <h1>Article not found</h1>
    <p class="news-not-found__text">
      This article is not published yet, has been withdrawn, or the address is mistyped.
    </p>
    <p class="news-not-found__text"><a href="/news">Browse all DAJC News &rarr;</a></p>
  </main>
</BaseLayout>

<style>
  .news-not-found {
    position: relative;
    z-index: 2;
    max-width: 960px;
    margin: 0 auto;
    padding: 12vh 1.5rem;
    text-align: center;
  }

  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dajc-orange);
    margin: 0 0 1.2rem;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--dajc-white);
  }

  .news-not-found__text {
    font-size: 16px;
    line-height: 1.75;
    color: var(--dajc-muted);
    max-width: 56ch;
    margin: 0 auto 1rem;
  }

  .news-not-found__text a {
    color: var(--dajc-orange);
  }
</style>
