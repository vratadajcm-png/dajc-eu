---
---
<section class="intelligence-teaser" aria-labelledby="intelligence-heading">
  <div class="intelligence-teaser__inner">
    <p class="intelligence-teaser__eyebrow">Operational intelligence</p>
    <h2 id="intelligence-heading">From a weekly briefing to changes you can act on.</h2>
    <p class="intelligence-teaser__text">
      DAJC Intelligence is the next layer above the public Driving Bans Calendar and EU Oversize Weekly:
      saved jurisdictions and corridors, vehicle-aware relevance, change detection, alerts and history.
    </p>
    <div class="intelligence-teaser__actions">
      <a class="primary" href="/intelligence">Explore DAJC Intelligence</a>
      <a href="/driving-bans">Open Driving Bans Calendar</a>
    </div>
  </div>
</section>

<style>
  .intelligence-teaser{position:relative;z-index:2;padding:3.5rem 1.5rem 4rem;border-top:1px solid var(--dajc-line)}
  .intelligence-teaser__inner{max-width:960px;margin:0 auto;text-align:center;padding:clamp(1.5rem,4vw,2.4rem);border:1px solid var(--dajc-orange);border-radius:16px;background:linear-gradient(135deg,rgba(255,159,0,.08),rgba(0,38,92,.22))}
  .intelligence-teaser__eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--dajc-orange);margin:0 0 .65rem}
  .intelligence-teaser h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(1.4rem,3vw,2rem);margin:0 0 .85rem;color:var(--dajc-white)}
  .intelligence-teaser__text{max-width:66ch;margin:0 auto;color:var(--dajc-muted);font-size:15px;line-height:1.7}
  .intelligence-teaser__actions{display:flex;flex-wrap:wrap;justify-content:center;gap:.7rem;margin-top:1.4rem}
  .intelligence-teaser__actions a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 1rem;border:1px solid var(--dajc-orange);border-radius:8px;color:var(--dajc-orange);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none}
  .intelligence-teaser__actions a.primary{background:var(--dajc-orange);color:var(--dajc-dark)}
</style>
