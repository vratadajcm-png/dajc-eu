---
---
<header class="mark">
  <img src="/assets/dajc-icon-mono-white.png" alt="" />
  <span>DAJC</span>
</header>

<style>
  header.mark {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 2.2rem 2.4rem 0;
  }

  header.mark img {
    width: 28px;
    height: 28px;
    opacity: 0.9;
  }

  header.mark span {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    color: var(--dajc-white);
  }

  @media (max-width: 560px) {
    header.mark {
      padding: 1.6rem 1.4rem 0;
    }
  }
</style>
