---
---
<header class="mark">
  <a class="brand" href="/" aria-label="DAJC home">
    <img src="/assets/dajc-icon-mono-white.png" alt="" />
    <span>DAJC</span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="/#platform">Platform</a>
    <a href="/intelligence">Intelligence</a>
    <a href="/driving-bans">Driving Bans</a>
    <a href="/partners">Integrations</a>
    <a href="/news">News</a>
    <a href="/pricing">Pricing</a>
    <a href="/support">Support</a>
    <a class="demo-cta" href="https://demo.dajc.eu" target="_blank" rel="noopener">Live Demo</a>
    <a class="testing-cta" href="/testing">Testing 2027</a>
  </nav>
</header>

<style>
  header.mark {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.2rem 2.4rem 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  header.mark img {
    width: 28px;
    height: 28px;
    opacity: 0.9;
  }

  header.mark span {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    color: var(--dajc-white);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dajc-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--dajc-orange);
  }

  nav a.testing-cta {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    padding: 0 0.9rem;
    border: 1px solid var(--dajc-orange);
    border-radius: 7px;
    background: var(--dajc-orange);
    color: var(--dajc-dark);
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(239, 125, 0, 0.18);
  }

  nav a.testing-cta:hover,
  nav a.testing-cta:focus-visible {
    color: var(--dajc-dark);
    transform: translateY(-1px);
  }

  nav a.demo-cta {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    padding: 0 0.75rem;
    border: 1px solid var(--dajc-line);
    border-radius: 7px;
    background: transparent;
    color: var(--dajc-muted);
    font-weight: 500;
  }

  nav a.demo-cta:hover,
  nav a.demo-cta:focus-visible {
    border-color: var(--dajc-orange);
    color: var(--dajc-orange);
    transform: translateY(-1px);
  }

  @media (max-width: 560px) {
    header.mark {
      padding: 1.6rem 1.4rem 0;
      align-items: flex-start;
    }

    nav {
      max-width: 72%;
      gap: 0.5rem 0.75rem;
      flex-direction: row;
      align-items: flex-start;
      justify-content: flex-end;
    }
  }
</style>
