# build output
dist/
.astro/
.vercel/

# dependencies
node_modules/

# environment
.env
.env.local

# editor/OS
.DS_Store

# safety net: generate-weekly-article.mjs --dry-run always deletes its own
# throwaway file before exiting, but ignore the pattern too in case a run
# is killed mid-way and a temp file is left behind
src/content/news/eu-oversize/_dry-run-*.md

# Reproducible CI evidence; durable migration backups live in archive/.
artifacts/

# Raw evidence documents of the Driving Bans import store stay local;
# their SHA-256 metadata in data/driving-bans/staging/evidence/ is committed.
data/driving-bans/staging/blobs/

# AI research documents stay local like the evidence blobs; their metadata is committed.
data/driving-bans/staging/research/blobs/
